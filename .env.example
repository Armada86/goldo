TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-chat-id
TWELVE_DATA_API_KEY=your-twelvedata-api-key
FRED_API_KEY=your-fred-api-key
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Used only by release_watch_job.py, for same-minute ADP/NFP release detection via FMP's
# economic-calendar endpoint. Leave unset to have that job no-op with a log line.
FMP_API_KEY=your-financialmodelingprep-api-key
# Optional -- fires the "ADP/NFP release watcher" Claude Code Routine's API trigger the moment
# an ADP_EMPLOYMENT/NONFARM_PAYROLLS alert fires, instead of waiting for its hourly schedule.
# Leave unset to skip this (routine_trigger.py no-ops with a log line). Generate these from the
# routine's "API trigger" section at claude.ai/code/routines.
ROUTINE_FIRE_URL=https://api.anthropic.com/v1/claude_code/routines/trig_xxx/fire
ROUTINE_FIRE_TOKEN=sk-ant-oat01-xxxxx
# Optional -- only required to run forex_broker.py by hand (see CLAUDE.md's "Forex broker" entry).
# Never read by main.py/poll_job.py -- this module is not part of the automatic poll cycle.
FOREX_USERNAME=your-forex.com-demo-username
FOREX_PASSWORD=your-forex.com-demo-password
FOREX_APP_KEY=your-forex.com-app-key
